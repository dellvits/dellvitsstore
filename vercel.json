{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm ci --include=dev --prefix ../..",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "installCommand": "npm ci --include=dev --prefix ../..",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "api" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
