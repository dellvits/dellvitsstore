FROM node:24-bookworm-slim AS build

WORKDIR /app

COPY package.json ./

RUN npm install --include=dev

COPY tsconfig.json ./
COPY src ./src

RUN npm run build


FROM node:24-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY package.json ./

RUN npm install --omit=dev

COPY --from=build /app/dist ./dist

# Make the deployment fail early if Sharp cannot load.
RUN node -e "import('sharp').then(() => console.log('sharp ready'))"

CMD ["node", "dist/index.js"]