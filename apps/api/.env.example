PORT=4000
WEB_ORIGIN=http://localhost:3000
# Supabase: Connect -> Transaction pooler -> URI (port 6543).
# Replace the password with its URL-encoded value. Keep this server-only.
# NEVER put real credentials in this file - it is committed to git. Use .env instead.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase's chain is self-signed, so this CA is required in production.
# Download "prod-ca-2021.crt" from Supabase and paste it as one quoted line with \n escapes.
DATABASE_SSL_CA=

# Cloudflare R2: private bucket, S3 Object Read & Write credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dellvit-uploads

NODE_ENV=development
# Use 1 on Vercel; keep 0 for direct local development.
TRUST_PROXY=0

# Only needed while running npm run bootstrap. Remove the password afterwards.
# ADMIN_EMAIL=
# ADMIN_NAME=Store owner
# ADMIN_PASSWORD=

# Optional Web Push overrides; otherwise keys are generated in PostgreSQL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
