{
  "name": "@dellvit/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "npm run build && node dist/seed.js",
    "db:migrate": "npm run build && node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "bootstrap": "npm run build && node dist/bootstrap.js",
    "import:local": "npm run build && node dist/import-local.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.23.0",
    "sharp": "^0.34.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
